<Style name="roads-access-cross">
	<Rule>
		&maxscale_zoom14;
		&minscale_zoom14;
		<Filter>([highway] = 'unclassified' or [highway] = 'service' or [highway] = 'residential') and ([access] = 'no' or [access] = 'private')</Filter>
		<TextSymbolizer fontset-name="sans-condensed" size="12" fill="black" opacity="0.85" halo-fill="white" halo-radius="1.5" placement="line" spacing="100">"✕"</TextSymbolizer>
	</Rule>
